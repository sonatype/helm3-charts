@Library(['private-pipeline-library', 'jenkins-shared', 'int-jenkins-shared']) _

final jira = [
    versionPrefix: '', project: 'CLM', projectId: '10002',
    credentialId : 'atlassian-jenkins-svc', autoRelease: true, failOnError: true
]

final chartLocation = [
  'nexus-iq-server': 'nexus-iq',
  'nexus-repository-manager': 'nexus-repository-manager',
]

properties([
  parameters([
    choice(
      choices: ['', 'nexus-iq-server', 'nexus-repository-manager'],
      name: 'chart',
      description: 'Chart to deploy.',
    ),
    string(
      name: 'appVersion',
      description: 'Version of the application image, like "1.139.0"',
    ),
    string(
      name: 'chartVersion',
      description: '(Optional) Version of the Chart, like "139.0.0". If omitted, it will be calculated from the appVersion.',
    ),
  ])
])

final chartVersion = calculateChartVersion(params.chartVersion, params.appVersion)
final haArtifactName = "nxrm-ha-${chartVersion}.tgz"
final nexusIqServerHaArtifactName = "nexus-iq-server-ha-${chartVersion}.tgz"

dockerizedBuildPipeline(
  prepare: {
    if (! params.chart) {
      error('Chart parameter is required.')
    }
    if (! params.appVersion) {
      error('The appVersion is required.')
    }
    // The release tag is created last, so if it exists this version was already published: skip the remaining stages
    // (dockerizedBuildPipeline skips them while .skip-build exists) instead of republishing it.
    String releaseTag = 'nexus-repository-manager'.equals(params.chart) ? "nxrm-ha-${chartVersion}" : "${params.chart}-${chartVersion}"
    boolean released = false
    sshagent(credentials: [sonatypeZionCredentialsId()]) {
      released = sh(script: "git ls-remote --exit-code --tags origin 'refs/tags/${releaseTag}'", returnStatus: true) == 0
    }
    if (released) {
      echo "${params.chart} ${chartVersion} was already published (tag ${releaseTag} exists); nothing to do"
      currentBuild.description = "Skipped - ${params.chart} ${chartVersion} already published"
      writeFile file: '.skip-build', text: 'true'
      return
    }
    githubStatusUpdate('pending')
  },
  buildAndTest: {
    sonatypeZionGitConfig()
    runSafely "git checkout ${gitBranch(env)}"
    if ('nexus-iq-server'.equals(params.chart)) {
      runSafely "curl -fL 'https://github.com/sonatype/nexus-iq-server-ha/blob/main/docs/${nexusIqServerHaArtifactName}?raw=true' -o 'docs/${nexusIqServerHaArtifactName}'"
      runSafely "./upgrade.sh charts/nexus-iq ${chartVersion} ${params.appVersion}"
      runSafely './build-iq.sh'
      runSafely 'git add charts'
    }

    if ('nexus-repository-manager'.equals(params.chart)) {
      runSafely "curl -fL 'https://github.com/sonatype/nxrm3-ha-repository/blob/main/docs/${haArtifactName}?raw=true' -o 'docs/${haArtifactName}'"
      runSafely './build-nexus.sh'
    }
  },
  skipVulnerabilityScan: true,
  archiveArtifacts: 'docs/*',
  testResults: [],
  deployCondition: { true },
  retentionPolicy: RetentionPolicy.TEN_BUILDS,
  deploy: {
    runSafely 'git add docs'
    runSafely "git commit -m 'Release Update for ${params.chart} ${chartVersion}'"

    sshagent(credentials: [sonatypeZionCredentialsId()]) {
      runSafely 'git push'
    }
  },
  postDeploy: {
    // Verify Index.yaml
    String version = ""

     if ('nexus-repository-manager'.equals(params.chart)) {
          version = verifyIndexYamlAndTarFile('nxrm-ha' , chartVersion)
     } else {
          version = verifyIndexYamlAndTarFile(params.chart, chartVersion)
     }

    // Set Jira Fix Version
    if ('nexus-iq-server' == params.chart) {
      jira.versionPrefix = 'helm-iq'
      jiraSetFixVersion(jira, version)
    }

    // Create tags
    String tagName = ""
    if ('nexus-repository-manager'.equals(params.chart)) {
      tagName = "nxrm-ha-${version}"
    } else {
      tagName = "${chart}-${version}"
    }
    runSafely "git tag -a ${tagName} -m 'Release Update: ${version}'"
    sshagent(credentials: [sonatypeZionCredentialsId()]) {
      runSafely "git push origin ${tagName}"
    }
  },
  onSuccess: {
    buildNotifications(currentBuild, env, 'main')
  },
  onFailure: {
    buildNotifications(currentBuild, env, 'main')
  }
)

String verifyIndexYamlAndTarFile(String chart, String chartVersion) {
  def indexFile = readYaml file: 'docs/index.yaml'
  // Find the chart we are releasing
  def entry = indexFile.entries[chart].find { it.version == chartVersion }
  if (!entry) {
    error "Version ${chartVersion} not found in index.yaml for chart ${chart}"
  }
  String version = entry.version

  // GitHub Pages publishes a push about a minute later, so wait for its index.yaml to list the version.
  String repo_url = 'https://sonatype.github.io/helm3-charts/'
  String repositoryVersion = null
  for (int attempt = 1; attempt <= 5 && !repositoryVersion; attempt++) {
    def response = httpRequest "${repo_url}/index.yaml"
    repositoryVersion = readYaml(text: response.content).entries[chart]?.find { it.version == chartVersion }?.version
    if (!repositoryVersion && attempt < 5) {
      echo "Version ${chartVersion} not in remote index.yaml yet (attempt ${attempt} of 5), waiting 60s"
      sleep(time: 60, unit: 'SECONDS')
    }
  }
  if (!repositoryVersion) {
    error "Version ${chartVersion} not found in remote index.yaml for chart ${chart}"
  }

  // Check tar file
  verifyDownloadLinks(
    urlParts: [repo_url, chart, '-', version],
    urlSuffixes: ['.tgz'], retryCount: 2, retryDelay: 60
  )

  if (!version.equals(repositoryVersion)) {
    error "Released version: ${version} is different " +
          "from helm repository version: ${repositoryVersion}"
  }

  return repositoryVersion
}

String calculateChartVersion(final String chartVersion, final String appVersion) {
  if (chartVersion) {
    return chartVersion
  }

  if (! appVersion) {
    error 'Failed to calculate chartVersion with no appVersion.'
  }

  final versionParts = parseVersionString(appVersion)
  final chartMajor = versionParts[1]
  final chartMinor = versionParts[2]

  if (! chartMajor || ! chartMinor) {
    error "Failed to calculate chartVersion from appVersion: ${appVersion}"
  }

  return [chartMajor, chartMinor, '0'].join('.')
}
